{
  "name": "campushub-student-planner",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "CampusHub student planner \u2014 React, Express and MongoDB full-stack WAD project",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "nodemon server/index.js",
    "dev:web": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "migrate:json": "node scripts/migrate-json-to-mongodb.js",
    "test": "node --test",
    "practical:http": "node syllabus-practicals/node/core-http.js",
    "practical:files": "node syllabus-practicals/node/files-events.js",
    "practical:upload": "node syllabus-practicals/node/upload-server.js",
    "practical:email": "node syllabus-practicals/node/send-email.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "vite": "^6.0.7"
  }
}
